<div class="hero">
  <h1>Find medicine information</h1>
  <div class="search-box">
    <input type="text" id="search-input" placeholder="Search by medicine name..." autocomplete="off">
    <div id="search-results" class="search-results"></div>
  </div>
</div>

<div class="groups-grid">
  <% groups.forEach(g => { %>
    <a href="/?group=<%= g.slug %>" class="group-card">
      <span class="group-name"><%= g.name %></span>
      <span class="group-count"><%= g.medicine_count %></span>
    </a>
  <% }) %>
</div>

<% if (filtered) { %>
  <section class="section">
    <h2><%= filtered.group.name %></h2>
    <% if (filtered.medicines.length === 0) { %>
      <div class="empty-state">No medicines in this group yet.</div>
    <% } else { %>
      <div class="medicines-list">
        <% filtered.medicines.forEach(m => { %>
          <a href="/medicine/<%= m.id %>" class="medicine-row">
            <span class="medicine-name"><%= m.name %></span>
            <% if (m.english_name) { %>
              <span class="medicine-en"><%= m.english_name %></span>
            <% } %>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
<% } %>

<section class="section">
  <h2>Recently Added</h2>
  <% if (recent.length === 0) { %>
    <div class="empty-state">No medicines added yet.</div>
  <% } else { %>
    <div class="medicines-list">
      <% recent.forEach(m => { %>
        <a href="/medicine/<%= m.id %>" class="medicine-row">
          <span class="medicine-name"><%= m.name %></span>
          <span class="medicine-group"><%= m.group_name %></span>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>
